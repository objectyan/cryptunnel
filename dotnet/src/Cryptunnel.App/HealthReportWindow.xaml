<Window x:Class="Cryptunnel.App.HealthReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:Cryptunnel.App"
        xmlns:vm="clr-namespace:Cryptunnel.App.Models"
        mc:Ignorable="d"
        Title="隧道健康检查" Height="520" Width="640"
        Background="#080a0f" Foreground="#eaf0fb"
        FontFamily="Segoe UI, Microsoft YaHei, sans-serif"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        WindowStyle="None" AllowsTransparency="False"
        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
    <Window.Resources>
        <SolidColorBrush x:Key="Tx1" Color="#eaf0fb"/>
        <SolidColorBrush x:Key="Tx2" Color="#a7b3c7"/>
        <SolidColorBrush x:Key="Tx3" Color="#6c7890"/>
        <SolidColorBrush x:Key="Accent" Color="#4c8dff"/>
        <SolidColorBrush x:Key="Danger" Color="#ff5d6c"/>
        <SolidColorBrush x:Key="Warn" Color="#ffb02e"/>
        <SolidColorBrush x:Key="Hair" Color="#ffffff" Opacity="0.12"/>
        <SolidColorBrush x:Key="Glass" Color="#ffffff" Opacity="0.055"/>
        <SolidColorBrush x:Key="Glass2" Color="#ffffff" Opacity="0.09"/>
        <LinearGradientBrush x:Key="WinBg" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0e1320" Offset="0"/>
            <GradientStop Color="#080a10" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="DlgBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Glass}"/>
            <Setter Property="Foreground" Value="{StaticResource Tx1}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Hair}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Glass2}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Background="{StaticResource WinBg}"/>
        <Ellipse Width="420" Height="420" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-160,-140,0" Opacity="0.22">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#7c5cff" Offset="0"/>
                    <GradientStop Color="#007c5cff" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- 标题栏 -->
            <Border Grid.Row="0" Height="40" Background="Transparent" Margin="-14,-14,-14,0">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="22" Height="22" CornerRadius="7">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#7c5cff"/><GradientStop Color="#4c8dff" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="J" Foreground="#fff" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="隧道健康检查" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Tx1}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Width="32" Height="26" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Tx2}" FontSize="13" Cursor="Hand" Click="BtnClose_Click" Content="✕">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="7"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Danger}"/>
                                        <Setter Property="Foreground" Value="#fff"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- 总览：结论 + 项目 + 算法 + 总耗时 -->
            <Border Grid.Row="1" Margin="0,10,0,10" Padding="14,12" CornerRadius="12"
                    Background="{StaticResource Glass}" BorderBrush="{StaticResource Hair}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21" VerticalAlignment="Top"
                            Background="{Binding VerdictBrush, Mode=OneWay}">
                        <TextBlock Text="{Binding VerdictIcon, Mode=OneWay}" FontSize="20" FontWeight="Bold"
                                   Foreground="#fff" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Text="{Binding VerdictText, Mode=OneWay}" FontSize="15.5" FontWeight="Bold"
                                   Foreground="{Binding VerdictBrush, Mode=OneWay}" TextWrapping="Wrap"/>
                        <TextBlock Margin="0,6,0,0" FontSize="12.5" TextWrapping="Wrap">
                            <Run Text="项目 " Foreground="{StaticResource Tx3}"/>
                            <Run Text="{Binding DisplayName, Mode=OneWay}" Foreground="{StaticResource Tx1}" FontWeight="SemiBold"/>
                            <Run Text="    加密算法 " Foreground="{StaticResource Tx3}"/>
                            <Run Text="{Binding CipherId, Mode=OneWay}" Foreground="{StaticResource Tx2}" FontFamily="Consolas, Courier New"/>
                        </TextBlock>
                        <TextBlock Margin="0,3,0,0" FontSize="12.5" TextWrapping="Wrap">
                            <Run Text="总耗时 " Foreground="{StaticResource Tx3}"/>
                            <Run Text="{Binding TotalText, Mode=OneWay}" Foreground="{StaticResource Tx2}" FontFamily="Consolas, Courier New"/>
                            <Run Text="{Binding VersionText, Mode=OneWay}" Foreground="{StaticResource Tx2}"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 分层结果 -->
            <Border Grid.Row="2" Background="{StaticResource Glass}" BorderBrush="{StaticResource Hair}" BorderThickness="1" CornerRadius="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="6">
                    <ItemsControl ItemsSource="{Binding Stages, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:HealthStageVm">
                                <Border Margin="4,5" Padding="12,10" CornerRadius="10"
                                        Background="{StaticResource Glass}" BorderBrush="{StaticResource Hair}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Icon, Mode=OneWay}" FontSize="15" FontWeight="Bold"
                                                   Width="24" VerticalAlignment="Top" Margin="0,1,0,0"
                                                   Foreground="{Binding Brush, Mode=OneWay}"/>

                                        <StackPanel Grid.Column="1" Margin="4,0,10,0">
                                            <TextBlock Text="{Binding StageName, Mode=OneWay}" FontSize="13.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Tx1}"/>
                                            <TextBlock Text="{Binding Summary, Mode=OneWay}" FontSize="12.5" Margin="0,4,0,0"
                                                       Foreground="{StaticResource Tx2}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Advice, Mode=OneWay}" FontSize="12" Margin="0,6,0,0"
                                                       Foreground="{StaticResource Warn}" TextWrapping="Wrap"
                                                       Visibility="{Binding AdviceVisibility, Mode=OneWay}"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding ElapsedText, Mode=OneWay}" FontSize="12"
                                                   VerticalAlignment="Top" Foreground="{StaticResource Tx3}"
                                                   FontFamily="Consolas, Courier New"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- 底部操作 -->
            <Grid Grid.Row="3" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding CostHint, Mode=OneWay}" FontSize="11.5"
                           Foreground="{StaticResource Tx3}" VerticalAlignment="Center" TextWrapping="Wrap"
                           Margin="2,0,10,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnCopy" Content="复制报告" Padding="12,7" Margin="0,0,8,0" Click="BtnCopy_Click" Style="{StaticResource DlgBtn}"/>
                    <Button x:Name="BtnRetest" Content="重新检查" Padding="12,7" Margin="0,0,8,0" Click="BtnRetest_Click" Style="{StaticResource DlgBtn}"/>
                    <Button Content="关闭" Padding="12,7" Width="80" IsDefault="True" IsCancel="True" Click="BtnClose_Click" Style="{StaticResource DlgBtn}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
