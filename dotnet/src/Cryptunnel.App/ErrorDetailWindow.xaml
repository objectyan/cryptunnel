<Window x:Class="Cryptunnel.App.ErrorDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:Cryptunnel.App"
        xmlns:models="clr-namespace:Cryptunnel.App.Models"
        mc:Ignorable="d"
        Title="错误 / 警告明细" Height="460" Width="680"
        Background="#080a0f" Foreground="#eaf0fb"
        FontFamily="Segoe UI, Microsoft YaHei, sans-serif"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        WindowStyle="None" AllowsTransparency="False"
        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
    <Window.Resources>
        <SolidColorBrush x:Key="Tx1" Color="#eaf0fb"/>
        <SolidColorBrush x:Key="Tx2" Color="#a7b3c7"/>
        <SolidColorBrush x:Key="Tx3" Color="#6c7890"/>
        <SolidColorBrush x:Key="Accent" Color="#4c8dff"/>
        <SolidColorBrush x:Key="Danger" Color="#ff5d6c"/>
        <SolidColorBrush x:Key="Warn" Color="#ffb02e"/>
        <SolidColorBrush x:Key="Hair" Color="#ffffff" Opacity="0.12"/>
        <SolidColorBrush x:Key="Glass" Color="#ffffff" Opacity="0.055"/>
        <SolidColorBrush x:Key="Glass2" Color="#ffffff" Opacity="0.09"/>
        <LinearGradientBrush x:Key="WinBg" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0e1320" Offset="0"/>
            <GradientStop Color="#080a10" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="DlgBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Glass}"/>
            <Setter Property="Foreground" Value="{StaticResource Tx1}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Hair}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Glass2}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Background="{StaticResource WinBg}"/>
        <Ellipse Width="420" Height="420" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-160,-140,0" Opacity="0.22">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#7c5cff" Offset="0"/>
                    <GradientStop Color="#007c5cff" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Height="40" Background="Transparent" Margin="-14,-14,-14,0">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="22" Height="22" CornerRadius="7">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#7c5cff"/><GradientStop Color="#4c8dff" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="J" Foreground="#fff" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="错误 / 警告明细" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Tx1}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Width="32" Height="26" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Tx2}" FontSize="13" Cursor="Hand" Click="BtnClose_Click" Content="✕">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="7"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Danger}"/>
                                        <Setter Property="Foreground" Value="#fff"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <TextBlock Grid.Row="1" Margin="2,12,2,12" FontSize="14">
                <Run Text="项目：" Foreground="{StaticResource Tx3}"/>
                <Run Text="{Binding ProjectName, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource Tx1}"/>
                <Run Text="    错误 " Foreground="{StaticResource Tx3}"/>
                <Run Text="{Binding ErrorCount, Mode=OneWay}" Foreground="{StaticResource Danger}" FontWeight="Bold"/>
                <Run Text=" / 警告 " Foreground="{StaticResource Tx3}"/>
                <Run Text="{Binding WarnCount, Mode=OneWay}" Foreground="{StaticResource Warn}" FontWeight="Bold"/>
                <Run Text="{Binding FilterLabel, Mode=OneWay}" Foreground="{StaticResource Tx3}"/>

            </TextBlock>

            <Border Grid.Row="2" Background="{StaticResource Glass}" BorderBrush="{StaticResource Hair}" BorderThickness="1" CornerRadius="12">
                <ListBox x:Name="ListBox" ItemsSource="{Binding Items, Mode=OneWay}" Background="Transparent" BorderThickness="0" Margin="6"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="models:LogLine">
                            <StackPanel Orientation="Horizontal" Margin="2,3">
                                <TextBlock Text="{Binding LevelText, Mode=OneWay}" Width="46" FontWeight="Bold" Foreground="{Binding Color, Mode=OneWay}" FontSize="12"/>
                                <TextBlock Text="{Binding Time, StringFormat=HH\:mm\:ss, Mode=OneWay}" Width="74" Foreground="{StaticResource Tx3}" FontFamily="Consolas, Courier New" FontSize="12"/>
                                <TextBlock Text="{Binding Message, Mode=OneWay}" Foreground="{StaticResource Tx1}" TextWrapping="Wrap" FontSize="12"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="2,1"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="BtnOpenLog" Content="打开日志目录" Padding="12,7" Margin="0,0,8,0" Click="BtnOpenLog_Click" Style="{StaticResource DlgBtn}"/>
                <Button Content="关闭" Padding="12,7" Width="80" IsDefault="True" Click="BtnClose_Click" Style="{StaticResource DlgBtn}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
