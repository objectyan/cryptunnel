<Window x:Class="Cryptunnel.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cryptunnel.App"
        xmlns:conv="clr-namespace:Cryptunnel.App.Converters"
        xmlns:models="clr-namespace:Cryptunnel.App.Models"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Cryptunnel 隧道客户端" Height="780" Width="1280"
        MinWidth="980" MinHeight="640"
        Background="#080a0f" Foreground="#eaf0fb"
        FontFamily="Segoe UI, Microsoft YaHei, sans-serif"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="False" ResizeMode="CanResize"
        AllowDrop="True" Drop="Window_Drop" DragEnter="Window_DragEnter" DragOver="Window_DragOver" DragLeave="Window_DragLeave">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome GlassFrameThickness="0" CaptionHeight="0" ResizeBorderThickness="6"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <conv:BytesConverter x:Key="Bytes"/>
        <conv:StateColorConverter x:Key="StateColor"/>
        <conv:RunningToText x:Key="RunningTxt"/>
        <conv:NonZeroConverter x:Key="NonZero"/>
        <conv:BytesToBarWidthConverter x:Key="BarW"/>

        <!-- 设计令牌 -->
        <SolidColorBrush x:Key="Tx1" Color="#eaf0fb"/>
        <SolidColorBrush x:Key="Tx2" Color="#a7b3c7"/>
        <SolidColorBrush x:Key="Tx3" Color="#6c7890"/>
        <SolidColorBrush x:Key="Accent" Color="#4c8dff"/>
        <SolidColorBrush x:Key="Accent2" Color="#7c5cff"/>
        <SolidColorBrush x:Key="Success" Color="#34e3a0"/>
        <SolidColorBrush x:Key="Warn" Color="#ffb02e"/>
        <SolidColorBrush x:Key="Danger" Color="#ff5d6c"/>
        <SolidColorBrush x:Key="Hair" Color="#ffffff" Opacity="0.12"/>
        <SolidColorBrush x:Key="HairSoft" Color="#ffffff" Opacity="0.06"/>
        <SolidColorBrush x:Key="Glass" Color="#ffffff" Opacity="0.055"/>
        <SolidColorBrush x:Key="Glass2" Color="#ffffff" Opacity="0.09"/>
        <SolidColorBrush x:Key="RowHover" Color="#ffffff" Opacity="0.05"/>

        <LinearGradientBrush x:Key="WinBg" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0e1320" Offset="0"/>
            <GradientStop Color="#080a10" Offset="1"/>
        </LinearGradientBrush>

        <!-- 标题栏按钮 -->
        <Style x:Key="WinBtn" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Tx2}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Glass2}"/>
                    <Setter Property="Foreground" Value="{StaticResource Tx1}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 工具栏按钮（幽灵 / 主） -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Glass}"/>
            <Setter Property="Foreground" Value="{StaticResource Tx1}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Hair}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Glass2}"/>
                    <Setter Property="BorderBrush" Value="#ffffff" />
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#7c5cff" Offset="0"/>
                        <GradientStop Color="#4c8dff" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#4c8dff" BlurRadius="16" ShadowDepth="0" Opacity="0.55"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Accent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 告警徽章 -->
        <Style x:Key="ErrBadge" TargetType="Button">
            <Setter Property="Background" Value="#29ff5d6c"/>
            <Setter Property="Foreground" Value="{StaticResource Danger}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="MinWidth" Value="26"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WarnBadge" TargetType="Button" BasedOn="{StaticResource ErrBadge}">
            <Setter Property="Background" Value="#29ffb02e"/>
            <Setter Property="Foreground" Value="{StaticResource Warn}"/>
        </Style>

        <!-- 开关（开机启动） -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Tx2}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Track" Width="30" Height="17" CornerRadius="9" Background="#39424f">
                                <Ellipse x:Name="Knob" Width="13" Height="13" Fill="#cfd6df" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                            </Border>
                            <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#7c5cff"/><GradientStop Color="#4c8dff" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Track" Property="Effect">
                                    <Setter.Value><DropShadowEffect Color="#4c8dff" BlurRadius="10" ShadowDepth="0" Opacity="0.6"/></Setter.Value>
                                </Setter>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0"/>
                                <Setter TargetName="Knob" Property="Fill" Value="#ffffff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox 自定义模板（深色下拉） -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource Glass}"/>
            <Setter Property="Foreground" Value="{StaticResource Tx1}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Hair}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                                        <Grid>
                                            <ContentPresenter ContentSource="Content" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                                            <Path Data="M0,0 L5,5 L10,0" Stroke="{StaticResource Tx3}" StrokeThickness="1.4" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" VerticalAlignment="Center" Margin="2,0,20,0"/>
                        </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" StaysOpen="False">
                                <Border Background="#11161f" BorderBrush="{StaticResource Hair}" BorderThickness="1" CornerRadius="9" Margin="0,4,0,0" Padding="4">
                                    <ScrollViewer MaxHeight="220">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Tx1}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Glass2}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#404c8dff"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid 基础 -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Tx1}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="RowHeight" Value="56"/>
            <Setter Property="ColumnHeaderHeight" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="EnableRowVirtualization" Value="False"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Tx3}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource Hair}"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei, sans-serif"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource RowHover}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1f4c8dff"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </Window.Resources>

    <Grid x:Name="Root">
        <!-- 背景渐变 + 霓虹光球 -->
        <Border Background="{StaticResource WinBg}"/>
        <Ellipse Width="640" Height="640" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-160,-200,0,0" Opacity="0.32">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#4c8dff" Offset="0"/>
                    <GradientStop Color="#004c8dff" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="560" Height="560" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-180,-220" Opacity="0.30">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#7c5cff" Offset="0"/>
                    <GradientStop Color="#007c5cff" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- 内容区：左导航栏 + 主区 -->
        <Grid Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 主区 -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 自定义标题栏 -->
                <Border Grid.Row="0" Height="46" Background="Transparent"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                            <Border Width="26" Height="26" CornerRadius="8">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#7c5cff"/><GradientStop Color="#4c8dff" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect Color="#4c8dff" BlurRadius="16" ShadowDepth="0" Opacity="0.6"/>
                                </Border.Effect>
                                <TextBlock Text="J" Foreground="#ffffff" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Cryptunnel 隧道客户端" VerticalAlignment="Center" Margin="11,0,0,0" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Tx1}"/>
                            <TextBlock Text="{Binding VersionText, Mode=OneWay}" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11" Foreground="{StaticResource Tx3}" FontFamily="Consolas, Courier New"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,10,0">
                            <Button Style="{StaticResource WinBtn}" Click="BtnMin_Click" ToolTip="最小化">
                                <Path Data="M0,5 H10" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.6" StrokeEndLineCap="Round"/>
                            </Button>
                            <Button Style="{StaticResource WinBtn}" Click="BtnMax_Click" ToolTip="最大化">
                                <Path Data="M1.5,1.5 H10.5 V10.5 H1.5 Z" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.5" Fill="Transparent"/>
                            </Button>
                            <Button Click="BtnClose_Click" ToolTip="关闭">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource WinBtn}">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{StaticResource Danger}"/>
                                                <Setter Property="Foreground" Value="#ffffff"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Path Data="M2,2 L10,10 M10,2 L2,10" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.6" StrokeEndLineCap="Round"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 健康总览卡片 -->
                <Grid Grid.Row="1" Margin="16,8,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource Glass}" BorderBrush="{StaticResource Hair}" BorderThickness="1" CornerRadius="14" Padding="14,12" Margin="0,0,6,0">
                        <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="0" Opacity="0.25"/></Border.Effect>
                        <StackPanel>
                            <TextBlock Text="隧道总数" FontSize="11" Foreground="{StaticResource Tx3}" TextOptions.TextFormattingMode="Display"/>
                            <TextBlock x:Name="OvTotal" Text="0" FontSize="28" FontWeight="Bold" FontFamily="Consolas, Courier New" Foreground="{StaticResource Accent}" Margin="0,6,0,0"/>
                            <TextBlock x:Name="OvTotalSub" Text="运行中 0" FontSize="11.5" Foreground="{StaticResource Tx2}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{StaticResource Glass}" BorderBrush="{StaticResource Hair}" BorderThickness="1" CornerRadius="14" Padding="14,12" Margin="6,0,6,0">
                        <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="0" Opacity="0.25"/></Border.Effect>
                        <StackPanel>
                            <TextBlock Text="已连接" FontSize="11" Foreground="{StaticResource Tx3}"/>
                            <TextBlock x:Name="OvConnected" Text="0" FontSize="28" FontWeight="Bold" FontFamily="Consolas, Courier New" Foreground="{StaticResource Success}" Margin="0,6,0,0"/>
                            <TextBlock x:Name="OvConnSub" Text="共 0 项" FontSize="11.5" Foreground="{StaticResource Tx2}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{StaticResource Glass}" BorderBrush="{StaticResource Hair}" BorderThickness="1" CornerRadius="14" Padding="14,12" Margin="6,0,6,0">
                        <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="0" Opacity="0.25"/></Border.Effect>
                        <StackPanel>
                            <TextBlock Text="异常" FontSize="11" Foreground="{StaticResource Tx3}"/>
                            <TextBlock x:Name="OvError" Text="0" FontSize="28" FontWeight="Bold" FontFamily="Consolas, Courier New" Foreground="{StaticResource Danger}" Margin="0,6,0,0"/>
                            <TextBlock Text="含错误 / 失败隧道" FontSize="11.5" Foreground="{StaticResource Tx2}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Background="{StaticResource Glass}" BorderBrush="{StaticResource Hair}" BorderThickness="1" CornerRadius="14" Padding="14,12" Margin="6,0,0,0">
                        <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="0" Opacity="0.25"/></Border.Effect>
                        <StackPanel>
                            <TextBlock Text="累计流量" FontSize="11" Foreground="{StaticResource Tx3}"/>
                            <TextBlock x:Name="OvTraffic" Text="↓ 0   ↑ 0" FontSize="16" FontWeight="Bold" FontFamily="Consolas, Courier New" Foreground="{StaticResource Tx1}" Margin="0,8,0,0"/>
                            <TextBlock Text="本次会话" FontSize="11.5" Foreground="{StaticResource Tx2}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 工具栏 -->
                <Border Grid.Row="2" Margin="16,12,16,0" Background="{StaticResource Glass}" BorderBrush="{StaticResource HairSoft}" BorderThickness="1" CornerRadius="12" Padding="12,9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontSize="12.5" VerticalAlignment="Center" Foreground="{StaticResource Tx3}">模式</TextBlock>
                            <TextBlock FontSize="12.5" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource Tx1}" Margin="5,0,0,0" Text="{Binding ModeText, Mode=OneWay}"/>
                            <Rectangle Width="1" Height="14" Fill="{StaticResource Hair}" Margin="12,0"/>
                            <TextBlock FontSize="12.5" VerticalAlignment="Center" Foreground="{StaticResource Tx3}">配置目录</TextBlock>
                            <TextBlock FontSize="12.5" VerticalAlignment="Center" Foreground="{StaticResource Tx1}" Margin="5,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="360" ToolTip="{Binding ConfigDir, Mode=OneWay}" Text="{Binding ConfigDir, Mode=OneWay}"/>
                            <Rectangle Width="1" Height="14" Fill="{StaticResource Hair}" Margin="12,0"/>
                            <TextBlock FontSize="12.5" VerticalAlignment="Center" Foreground="{StaticResource Tx2}">可拖入 <Run Foreground="{StaticResource Accent}" FontWeight="Bold">.yaml / .yml</Run> 快速导入</TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="↻ 重载配置" Click="BtnReload_Click" Style="{StaticResource PrimaryBtn}"/>
                            <Button Content="＋ 新建项目" Click="BtnNewProject_Click" Style="{StaticResource GhostBtn}"/>
                            <Button Content="配置目录" Click="BtnOpenConfig_Click" ToolTip="打开配置目录" Style="{StaticResource GhostBtn}"/>
                            <Button Content="日志目录" Click="BtnOpenLog_Click" ToolTip="打开日志目录" Style="{StaticResource GhostBtn}"/>
                            <CheckBox x:Name="ChkAutoStart" Content="开机启动" Style="{StaticResource ToggleSwitch}"
                                      Checked="ChkAutoStart_Changed" Unchecked="ChkAutoStart_Changed"/>
                            <Button Content="退出" Click="BtnExit_Click" Style="{StaticResource GhostBtn}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 中部项目表格（含空配置引导覆盖层） -->
                <Border Grid.Row="3" Margin="16,12,16,0" Background="{StaticResource Glass}" BorderBrush="{StaticResource Hair}" BorderThickness="1" CornerRadius="14" Padding="1">
                    <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="0" Opacity="0.3"/></Border.Effect>
                    <Grid>
                        <DataGrid x:Name="Grid" ItemsSource="{Binding Projects, Mode=OneWay}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                                  SelectionMode="Single" SelectionUnit="FullRow"
                                  MouseDoubleClick="Grid_MouseDoubleClick">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Setter Property="ToolTip">
                                        <Setter.Value>
                                            <ToolTip Background="#11161f" BorderBrush="{StaticResource Hair}" Foreground="{StaticResource Tx1}">
                                                <TextBlock>
                                                    <Run Text="本地地址：" Foreground="{StaticResource Tx3}"/><Run Text="{Binding ListenAddress, Mode=OneWay}"/><LineBreak/>
                                                    <Run Text="端口：" Foreground="{StaticResource Tx3}"/><Run Text="{Binding LocalPort, Mode=OneWay}"/><LineBreak/>
                                                    <Run Text="总连接数：" Foreground="{StaticResource Tx3}"/><Run Text="{Binding Connections, Mode=OneWay}"/><LineBreak/>
                                                    <Run Text="重连次数：" Foreground="{StaticResource Tx3}"/><Run Text="{Binding Reconnects, Mode=OneWay}"/><LineBreak/>
                                                    <Run Text="最后错误：" Foreground="{StaticResource Tx3}"/><Run Text="{Binding LastError, Mode=OneWay, TargetNullValue=无}"/>
                                                </TextBlock>
                                            </ToolTip>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="项目" Width="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name, Mode=OneWay}" FontFamily="Consolas, Courier New" FontWeight="SemiBold" Foreground="{StaticResource Tx1}"/>
                                                <TextBlock Text="{Binding DisplayName}" FontSize="11" Foreground="{StaticResource Tx3}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="本地端口" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding LocalPort, Mode=OneWay}" FontFamily="Consolas, Courier New" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Accent}">
                                                <TextBlock.Effect>
                                                    <DropShadowEffect Color="#4c8dff" BlurRadius="12" ShadowDepth="0" Opacity="0.5"/>
                                                </TextBlock.Effect>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="服务端地址" Binding="{Binding ServerUrl, Mode=OneWay}" Width="2*" MinWidth="200">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            <Setter Property="ToolTip" Value="{Binding ServerUrl, Mode=OneWay}"/>
                                            <Setter Property="Foreground" Value="{StaticResource Tx2}"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Header="状态" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Grid Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <Ellipse Width="15" Height="15" Fill="{Binding State, Converter={StaticResource StateColor}}" Opacity="0.28"/>
                                                        <Ellipse Width="9" Height="9" Fill="{Binding State, Converter={StaticResource StateColor}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding StatusText, Mode=OneWay}" Foreground="{Binding State, Converter={StaticResource StateColor}}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Transport}" FontSize="11" Foreground="{StaticResource Tx3}" Margin="0,3,0,0"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0"
                                                            Visibility="{Binding HealthVisibility, Mode=OneWay}"
                                                            ToolTip="{Binding HealthSummary, Mode=OneWay}">
                                                    <TextBlock Text="{Binding HealthIcon, Mode=OneWay}" FontSize="11" FontWeight="Bold"
                                                               Foreground="{Binding HealthBrush, Mode=OneWay}" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding HealthText, Mode=OneWay}" FontSize="11"
                                                               Foreground="{Binding HealthBrush, Mode=OneWay}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="连接" Binding="{Binding ActiveConnections}" Width="60">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Tx1}"/>
                                            <Setter Property="FontFamily" Value="Consolas, Courier New"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Header="流量" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="↓" Foreground="{StaticResource Success}" FontWeight="Bold" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding BytesIn, Converter={StaticResource Bytes}}" Foreground="{StaticResource Tx2}" FontFamily="Consolas, Courier New" FontSize="12"/>
                                                    <Rectangle Height="4" RadiusX="2" RadiusY="2" Fill="{StaticResource Success}" Width="{Binding BytesIn, Converter={StaticResource BarW}}" Margin="6,0,0,0"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="↑" Foreground="{StaticResource Warn}" FontWeight="Bold" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding BytesOut, Converter={StaticResource Bytes}}" Foreground="{StaticResource Tx2}" FontFamily="Consolas, Courier New" FontSize="12"/>
                                                    <Rectangle Height="4" RadiusX="2" RadiusY="2" Fill="{StaticResource Warn}" Width="{Binding BytesOut, Converter={StaticResource BarW}}" Margin="6,0,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="告警" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="{Binding Errors}" Click="BtnShowErrors_Click" Style="{StaticResource ErrBadge}"
                                                        IsEnabled="{Binding Errors, Converter={StaticResource NonZero}}"/>
                                                <Button Content="{Binding Warnings}" Click="BtnShowWarnings_Click" Style="{StaticResource WarnBadge}" Margin="6,0,0,0"
                                                        IsEnabled="{Binding Warnings, Converter={StaticResource NonZero}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="操作" Width="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="{Binding Running, Converter={StaticResource RunningTxt}}" Click="BtnToggle_Click" Padding="10,5" MinWidth="48">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource GhostBtn}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Running}" Value="True">
                                                                    <Setter Property="Background" Value="#29ff5d6c"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                                                    <Setter Property="BorderBrush" Value="#66ff5d6c"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Running}" Value="False">
                                                                    <Setter Property="Background" Value="#2934e3a0"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource Success}"/>
                                                                    <Setter Property="BorderBrush" Value="#6634e3a0"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="检查" Click="BtnTest_Click" Padding="10,5" MinWidth="44" Margin="6,0,0,0" Style="{StaticResource GhostBtn}"
                                                        ToolTip="健康检查：走真实链路验证网络、加密认证与数据库可达性（会在服务端建立并断开一条数据库连接）"/>
                                                <Button Content="删除" Click="BtnDelete_Click" Padding="10,5" MinWidth="44" Margin="6,0,0,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource GhostBtn}">
                                                            <Setter Property="Background" Value="{StaticResource Glass2}"/>
                                                            <Setter Property="Foreground" Value="{StaticResource Tx1}"/>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Background="#11161f" Visibility="{Binding Projects, Converter={StaticResource EmptyToVis}}" CornerRadius="14">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="暂无项目" FontSize="22" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" Margin="0,0,0,14" FontWeight="SemiBold"/>
                                <TextBlock Text="把 YAML 文件拖到此处导入，或点击下方按钮新建" Foreground="{StaticResource Tx2}" HorizontalAlignment="Center" Margin="0,0,0,20" FontSize="14"/>
                                <Button Content="新建项目" Click="BtnNewProject_Click" Padding="24,10" HorizontalAlignment="Center" FontSize="14" Style="{StaticResource PrimaryBtn}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- 底部实时日志（含筛选栏） -->
                <Border Grid.Row="4" Margin="16,12,16,16" Background="{StaticResource Glass}" BorderBrush="{StaticResource Hair}" BorderThickness="1" CornerRadius="14" Height="234">
                    <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="0" Opacity="0.3"/></Border.Effect>
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="14,10,14,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="实时日志" Foreground="{StaticResource Tx1}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center">
                                <TextBlock.Effect><DropShadowEffect Color="#4c8dff" BlurRadius="8" ShadowDepth="0" Opacity="0.4"/></TextBlock.Effect>
                            </TextBlock>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                <TextBlock Text="项目" Foreground="{StaticResource Tx3}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="CmbProject" Width="150" DropDownOpened="CmbProject_DropDownOpened" SelectionChanged="LogFilter_Changed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock Text="级别" Foreground="{StaticResource Tx3}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="CmbLevel" Width="92" SelectionChanged="LogFilter_Changed">
                                    <ComboBoxItem Content="全部"/>
                                    <ComboBoxItem Content="信息"/>
                                    <ComboBoxItem Content="警告"/>
                                    <ComboBoxItem Content="错误"/>
                                </ComboBox>
                            </StackPanel>
                            <TextBox x:Name="TxtSearch" Grid.Column="3" Margin="10,0,0,0" VerticalAlignment="Center" Height="30"
                                     ToolTip="搜索日志内容（支持正则，留空=不过滤）" TextChanged="TxtSearch_TextChanged"
                                     Background="{StaticResource Glass2}" Foreground="{StaticResource Tx1}" BorderBrush="{StaticResource Hair}" BorderThickness="1" Padding="10,5" CaretBrush="{StaticResource Accent}">
                                <TextBox.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="9"/></Style>
                                </TextBox.Resources>
                            </TextBox>
                            <CheckBox x:Name="ChkAutoScroll" Grid.Column="4" Content="自动滚动" Style="{StaticResource ToggleSwitch}"
                                      Checked="LogAutoScroll_Changed" Unchecked="LogAutoScroll_Changed" Margin="14,0,0,0"/>
                            <Button x:Name="BtnLogEnd" Grid.Column="5" Content="↓ 末尾" ToolTip="滚动到最新日志" Click="BtnRailLog_Click" Style="{StaticResource GhostBtn}" Margin="14,0,0,0"/>
                            <Button x:Name="BtnClearLog" Grid.Column="6" Content="清空" Click="BtnClearLog_Click" Style="{StaticResource GhostBtn}" Margin="14,0,0,0"/>
                        </Grid>
                        <ListBox x:Name="LogBox" Background="Transparent"
                                 BorderThickness="0" Margin="8,4,8,10" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text, Mode=OneWay}" Foreground="{Binding Color, Mode=OneWay}"
                                               FontFamily="Consolas, Courier New" FontSize="12" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Padding" Value="3,2"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- 拖拽导入覆盖层（D1 可发现性） -->
                <Grid Grid.Row="0" Grid.RowSpan="5" Panel.ZIndex="100" x:Name="DropOverlay" Visibility="Collapsed" IsHitTestVisible="False">
                    <Border Background="#05070c" Opacity="0.82">
                        <Border BorderBrush="{StaticResource Accent}" BorderThickness="2" CornerRadius="18" Margin="28"
                                Background="{StaticResource Glass2}" Opacity="0.96">
                            <Border.Effect><DropShadowEffect Color="#4c8dff" BlurRadius="26" ShadowDepth="0" Opacity="0.5"/></Border.Effect>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Path Data="M10,2 L10,11 M10,2 L6,6 M10,2 L14,6 M3,11 L3,18 L17,18 L17,11"
                                      Stroke="{StaticResource Accent}" StrokeThickness="2" StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                                      Stretch="Uniform" Width="56" Height="56" HorizontalAlignment="Center"/>
                                <TextBlock Text="拖放 .yaml / .yml 文件以导入项目" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Tx1}" Margin="0,14,0,6" HorizontalAlignment="Center"/>
                                <TextBlock Text="松开鼠标即可将配置添加到当前隧道客户端" FontSize="13" Foreground="{StaticResource Tx2}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
