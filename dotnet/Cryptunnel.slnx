<Solution>
  <!--
    ⚠ .NET 客户端已退役（迁往 Rust + Tauri，见 dotnet/rust/）。
    本 solution 只保留「跨语言字节对齐参照」所需的两个工程：
    - Cryptunnel.Core：仅含 Crypto/ 真实加密源码，被 parity 直接链接校验。
    - CryptoParity：跨语言（Java ↔ .NET ↔ Rust）加密字节对齐自检。
    请勿把这里当成现役客户端树；新的 UI / 隧道 / 配置代码一律进 dotnet/rust/。
  -->

  <!-- 字节对齐参照（仅 Crypto/） -->
  <Project Path="src/Cryptunnel.Core/Cryptunnel.Core.csproj" />

  <!-- 跨语言一致性校验（对 Java core 反解密文） -->
  <Project Path="build/parity/CryptoParity/CryptoParity.csproj" />
</Solution>
