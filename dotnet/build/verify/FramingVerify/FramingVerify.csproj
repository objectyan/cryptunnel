<Project Sdk="Microsoft.NET.Sdk">

  <!--
    帧上限守卫与认证报文构造器的验收工程（零 NuGet 依赖之外只需 YamlDotNet）。

    与 dotnet/build/parity/CryptoParity 同一思路：不引入 xunit，
    直接链接现役源码 + main + 断言 + 退出码，可离线跑。

    为什么必须实跑而不是只看代码：本轮要证明的是
    「chunkSize 配大了会在启动阶段被 ConfigLoader 拒掉」，
    这是一条跨 ConfigLoader -> TunnelFraming 的行为，只有真跑才算验过。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>FramingVerify</AssemblyName>
    <RootNamespace>FramingVerify</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.NET.Sdk 的隐式 using 集合不含 System.Text（Console.OutputEncoding 需要） -->
    <Using Include="System.Text" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 直接引用现役工程，验的就是真正在跑的实现 -->
    <ProjectReference Include="..\..\..\src\Cryptunnel.Core\Cryptunnel.Core.csproj" />
  </ItemGroup>

</Project>
