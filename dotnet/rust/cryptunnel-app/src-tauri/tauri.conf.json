{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cryptunnel",
  "version": "0.1.0",
  "identifier": "io.github.objectyan.cryptunnel",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cryptunnel 隧道客户端",
        "width": 900,
        "height": 620,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
