  "productName": "Cryptunnel",
  "version": "0.1.4",
  "identifier": "io.github.objectyan.cryptunnel",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cryptunnel 隧道客户端",
