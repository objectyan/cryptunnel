# ============================================================
# cryptunnel — .gitignore
# 注：本仓库有一个 Java 包名恰好叫 `target`
#   (java/cryptunnel-core/src/{main,test}/java/.../core/target/)
#   它是白名单源码，必须进库。下面用否定规则精确放行，
#   切勿写笼统的 `target/` 否则会误忽略源码包。
# ============================================================

# ---- Java / Maven 构建产物 ----
target/
# 放行名为 target 的源码包（只在 src/main|test/java 下）
!**/src/main/java/**/target/
!**/src/test/java/**/target/

# ---- 其他 Java 编译产物 ----
out/
*.class

# ---- Python 产物 ----
__pycache__/
*.pyc
*.pyo

# ---- .NET 构建产物 ----
**/bin/
# 放行 Rust 的 src/bin/（cargo 二进制源码目录，非构建产物）
!dotnet/rust/**/src/bin/
**/obj/
*.cache
*.user
*.suo
.vs/

# ---- IDE ----
.idea/
.vscode/
*.iml

# ---- NuGet 本地缓存（restore 时自动重建）----
.nuget-cache/
.nuget-packages/

# ---- 本地 agent / 工具状态（不入库）----
.workbuddy/

# ---- Rust / Cargo 构建产物 ----
# dotnet/rust 下的 target/ 已被上面全局 target/ 覆盖，此处仅注释说明；
# 全局否定规则只放行 java 源码包，不影响 rust 构建产物被忽略。
# Tauri 代码生成目录（tauri-build 产出，每次构建自动重建）
dotnet/rust/**/src-tauri/gen/

# ---- 发布产物（761MB，保留在本地磁盘，不进 git）----
packaging/

# ---- 操作系统文件 ----
.DS_Store
Thumbs.db
desktop.ini
